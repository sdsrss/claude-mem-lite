{
  "name": "claude-mem-lite",
  "version": "3.94.0",
  "description": "Persistent long-term memory for Claude Code via MCP — captures coding decisions, bugfixes, and context across sessions. Hybrid FTS5 + TF-IDF search with episode batching. Single SQLite DB, no external services. A lighter, lower-cost alternative to claude-mem (episode batching + a smaller model; cost savings are an internal estimate, not a measured benchmark).",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "claude-mem-lite": "./cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sdsrss/claude-mem-lite.git"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{mjs,js}\"",
    "format:check": "prettier --check \"**/*.{mjs,js}\"",
    "dead-code": "knip",
    "audit:metrics": "node scripts/audit-metrics.mjs --md",
    "audit:baseline": "node scripts/audit-metrics.mjs --run-tests --md",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke.test.mjs",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node benchmark/benchmark.mjs",
    "benchmark:gate": "node benchmark/ci-gate.mjs"
